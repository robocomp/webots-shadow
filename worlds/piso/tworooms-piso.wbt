# ---------------------------------------------------------------------------------------------
# GROUND -- a backstop, not scenery.
#
# Every walkable surface in this world is a finite trimesh (floor_tworooms.dae), so any hole in
# it, anywhere, drops the robot out of the world with no diagnostic beyond a falling z.  A Plane
# used as a boundingObject is INFINITE in Webots regardless of its rendered `size`, so this one
# catches the robot everywhere, including outside the building.  It sits 1 cm below z = 0: far
# enough not to z-fight the floor, close enough that if the robot ever does find a gap the
# symptom is a 1 cm drop you can see rather than a fall to -inf you have to instrument for.
#
# It also gives the world an outside.  Until now the apartment floated in the TexturedBackground
# void, which did not matter when the only room was sealed; room 2's floor has to run out to its
# walls' OUTER faces, so a 17 cm lip of slab is visible from outside along the south side.  On
# ground it reads as a foundation instead of as a mistake.
# ---------------------------------------------------------------------------------------------
Solid {
  translation -4.3 6.7 -0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.34 0.35 0.33
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 80 80
      }
    }
  ]
  name "Ground"
  boundingObject Plane {
    size 80 80
  }
  locked TRUE
}

# ---------------------------------------------------------------------------------------------
# ROOM 2 -- the far side of DOOR_1, for the "crossing door" problem.
#
# DOOR_1 (translation -4.77112 9.23958) sits in the apartment's NORTH wall, at the end of the
# short corridor that runs up from the living room.  Everything below is the room the robot ends
# up in after it opens that door and drives through; nothing here touches the apartment itself,
# so piso.wbt geometry (meshes/wall.dae, floor.dae, the door apertures in door_apertures.json)
# is bit-identical between the two worlds and anything fitted in room 1 stays valid.
#
# Deliberately a plain axis-aligned rectangle -- 6.0 x 4.0 m of clear floor, 3 m to the ceiling,
# no furniture.  The point of this world is the ROOM-TO-ROOM handover: re-run layout estimation
# from scratch on the far side and keep an anchor back through the door, so a featureless box is
# exactly what you want to fit first.  Add clutter later, once the anchor is trusted.
#
# Geometry, all world coordinates (x right, y up-the-page, z up):
#     interior   x in [-7.77, -1.77]   y in [ 9.48, 13.48]   z in [0, 3]
#     walls      0.11 m thick, matching THICKNESS in thicken_walls.py, height 3.0 = WALL_TOP
#     doorway    x in [-5.30, -4.24] left open in the south wall
#
# The south wall starts at y = 9.37 because that is where the apartment's own outer wall face
# ends: buffer(air_polygon, 0.11) peaks at y = 9.3676 (vertex -5.9798, 9.3676).  So the two
# slabs stack with 2 mm of air between them and nothing z-fights, and the doorway reads as a
# ~0.24 m deep tunnel: door leaf slab 9.19..9.29, apartment wall ..9.37, this wall 9.37..9.48.
#
# The door leaf never reaches this wall, because DOOR_1 opens SOUTH, back into the corridor:
# jointAtLeft is TRUE, so Door.proto:132 clamps the hinge to [-3.14, 0.01], and at -pi/2 the leaf
# swings onto the door's local +x, which this rotation (0 0 1 -1.5857206) maps to world -y.  The
# hinge anchor lands at about (-5.246, 9.14), the aperture's west edge, so a fully open leaf lies
# ALONG the line of travel at x = -5.25 rather than across it -- the robot still has the full
# x in [-5.25, -4.27] to drive through.  The corridor is 1.68 x 2.1 m (x in [-5.88, -4.20],
# y from 7.16 up to the door), so the 1 m leaf has room to swing without hitting its own walls.
#
# There is no floor node down here: room 2's floor is part of the "Floor" Solid above, which in
# this world points at meshes/floor_tworooms.dae instead of floor.dae.  One mesh, so the
# threshold is continuous -- see the comment there and make_floor_tworooms.py.
# ---------------------------------------------------------------------------------------------
Group {
  children [
    # ---- walls -------------------------------------------------------------------------------
    # Cooler grey than the apartment's beige so it is obvious in the viewport which side of the
    # door you are on.  Same normal map, so the LiDAR-relevant surface is identical.
    DEF ROOM2_WALL_SOUTH_WEST Solid {
      translation -6.535 9.425 1.5
      children [
        Shape {
          appearance DEF ROOM2_WALL_APP PBRAppearance {
            baseColor 0.87 0.89 0.92
            roughness 1
            metalness 0
            normalMap ImageTexture {
              url [
                "textures/pared/beige_wall_001_nor_dx_2k.jpg"
              ]
            }
            normalMapFactor 0.7
            occlusionMapStrength 0
            emissiveIntensity 0
            name "Room2Wall"
          }
          geometry Box {
            size 2.47 0.11 3
          }
        }
      ]
      name "Room2WallSouthWest"
      boundingObject Box {
        size 2.47 0.11 3
      }
      locked TRUE
    }
    DEF ROOM2_WALL_SOUTH_EAST Solid {
      translation -3.005 9.425 1.5
      children [
        Shape {
          appearance USE ROOM2_WALL_APP
          geometry Box {
            size 2.47 0.11 3
          }
        }
      ]
      name "Room2WallSouthEast"
      boundingObject Box {
        size 2.47 0.11 3
      }
      locked TRUE
    }
    DEF ROOM2_WALL_NORTH Solid {
      translation -4.77 13.535 1.5
      children [
        Shape {
          appearance USE ROOM2_WALL_APP
          geometry Box {
            size 6 0.11 3
          }
        }
      ]
      name "Room2WallNorth"
      boundingObject Box {
        size 6 0.11 3
      }
      locked TRUE
    }
    DEF ROOM2_WALL_WEST Solid {
      translation -7.825 11.48 1.5
      children [
        Shape {
          appearance USE ROOM2_WALL_APP
          geometry Box {
            size 0.11 4.22 3
          }
        }
      ]
      name "Room2WallWest"
      boundingObject Box {
        size 0.11 4.22 3
      }
      locked TRUE
    }
    DEF ROOM2_WALL_EAST Solid {
      translation -1.715 11.48 1.5
      children [
        Shape {
          appearance USE ROOM2_WALL_APP
          geometry Box {
            size 0.11 4.22 3
          }
        }
      ]
      name "Room2WallEast"
      boundingObject Box {
        size 0.11 4.22 3
      }
      locked TRUE
    }
    # ---- ceiling: a downward-facing plane at z = 3, same trick as the apartment "Ceiling" -----
    Solid {
      translation -4.77 11.48 3
      rotation 1 0 0 3.14159
      children [
        Shape {
          appearance PBRAppearance {
            roughness 1
            metalness 0
          }
          geometry Plane {
            size 6 4
          }
        }
      ]
      name "Room2Ceiling"
      locked TRUE
    }
    # ---- lighting: same lamp as the apartment grid, same 1.6 m pitch, so the two rooms expose
    #      the camera identically and a crossing does not look like a gain change ---------------
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -7.17 9.88 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -7.17 11.48 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -7.17 13.08 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -5.57 9.88 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -5.57 11.48 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -5.57 13.08 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -3.97 9.88 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
      color 1 0.92 0.82
      intensity 3.2
      location -3.97 11.48 2.9
      radius 18
    }
    PointLight {
      attenuation 0 0 1
