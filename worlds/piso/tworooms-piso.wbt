WorldInfo {
  basicTimeStep 8
  # The wheels declare contactMaterial "InteriorWheelMat" / "ExteriorWheelMat" (InteriorWheel.proto:86,
  # ExteriorWheel.proto:86), and WITHOUT these ContactProperties Webots falls back to default ISOTROPIC
  # friction -- the rollers stop sliding freely and the base behaves like a skid-steer rather than a
  # mecanum. This world was missing them entirely, and it is measurable: comparing the wheel-encoder
  # forward kinematics against the supervisor over 809 publish intervals on 2026-08-15, the effective
  # (LX+LY) came out at ~0.287 instead of the geometric 0.340 -- between the ideal-mecanum 0.340 and
  # the ideal-differential half-track 0.210, exactly what partial skidding looks like. The base was
  # therefore over-rotating ~18% against every commanded rot, which hits open-loop heading control as
  # well as odometry. Translation was unaffected (adv tracked ground truth to 0.1%), because it does
  # not depend on the roller anisotropy.
  # Copied verbatim from Shadow_v2.wbt. coulombFriction [0, 2, 0] is the anisotropy: zero along the
  # roller axis, 2 across it; frictionRotation +-45 deg orients it along the rollers, opposite for the
  # interior and exterior wheels, which is what makes the diagonal pairs work.
  contactProperties [
    ContactProperties {
      material1 "InteriorWheelMat"
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation -0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
    ContactProperties {
      # Differential drive wheels: ordinary isotropic rubber-on-floor grip. Nothing anisotropic here
      # -- that was only ever needed to make mecanum rollers slide sideways.
      # softCFM gives the contact a little compliance. The drive wheels and both casters rest at
      # EXACTLY z=0 (axle 0.100 with r=0.100; caster centre 0.040 with r=0.040), so the chassis sits
      # on four perfectly coplanar contacts -- statically over-constrained for a rigid body, which a
      # hard solver resolves by rocking fore and aft. A hair of compliance makes the load share
      # smoothly instead.
      material1 "DriveWheelMat"
      coulombFriction [
        1.2
      ]
      bounce 0
      bounceVelocity 0
      softCFM 0.0005
    }
    ContactProperties {
      # Ball casters. These are on BallJoints and ROLL, so they need ordinary friction rather than an
      # artificially slippery contact: a rolling ball follows the chassis without resisting a pivot.
      # The earlier 0.05 was compensating for casters that were bolted rigid and could only skid, and
      # it left the fore/aft rocking with nothing to dissipate against.
      material1 "CasterMat"
      coulombFriction [
        0.9
      ]
      bounce 0
      bounceVelocity 0
      softCFM 0.002
    }
    ContactProperties {
      material1 "ExteriorWheelMat"
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation 0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
  ]
}
